{
  "version": 2,
  "buildCommand": "npm --prefix cybersave-admin-frontend install && npm --prefix cybersave-admin-frontend run build && npm run build",
  "outputDirectory": "cybersave-admin-frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|health).*)",
      "destination": "/index.html"
    }
  ]
}
