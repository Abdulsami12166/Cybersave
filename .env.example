# 1. Server Configuration
PORT=10000
ADMIN_PORT=3001
NODE_ENV=production

# 2. Database Connection (PostgreSQL / Render Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cybersave?schema=public"

# 3. Authentication (JWT Security Tokens)
JWT_SECRET="cybersave-prod-jwt-secret-key-321-secure-production-key"
JWT_REFRESH_SECRET="cybersave-prod-jwt-refresh-secret-key-321-secure-production-key"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# 4. Firebase Admin SDK (Phone OTP Authentication & Push Notifications)
# IMPORTANT: Never commit firebase-adminsdk JSON files — use env vars instead
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 5. Cloudinary Storage (Document Uploads & Avatars)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 6. Twilio SMS Integration (Status Alerts & Notifications)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# 7. Google Gemini AI (CyberBot Assistant)
GEMINI_API_KEY="your_gemini_api_key"

# 8. Redis Configuration (BullMQ & Cache)
REDIS_URL="redis://default:password@localhost:6379"

# 9. Security
# Set DEV_OTP_ENABLED=true ONLY in local dev to receive OTP in API response. NEVER in production.
DEV_OTP_ENABLED=false
# Comma-separated list of allowed frontend origins. Restrict in production.
CORS_ORIGIN="https://your-admin-frontend.onrender.com,https://your-mobile-app.com"
